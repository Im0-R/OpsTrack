# Local .NET development works without this file (SQLite and an ephemeral JWT key).
# Docker Compose reads the two REQUIRED values below. Generate your own values.
SQL_SERVER_PASSWORD=
JWT_SECRET=

# Optional .NET environment variables. .NET does not load .env automatically.
# SQL Server example: Server=localhost,1433;Database=OpsTrack;User Id=sa;Password=YOUR_LOCAL_PASSWORD;TrustServerCertificate=True
# ConnectionStrings__DefaultConnection=
# Database__Provider=SqlServer
# Database__AutoMigrate=true
# Jwt__Secret=
# Jwt__Issuer=OpsTrack.Api
# Jwt__Audience=OpsTrack.Web
# Demo__Password=  (Development only, 12+ characters, empty database only)

# Vite reads this value from the root .env for its development proxy.
API_PROXY_TARGET=http://localhost:5080
